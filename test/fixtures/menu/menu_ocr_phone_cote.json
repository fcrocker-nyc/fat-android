494796264507]]}]},{"id":"AD85E30B-20D5-4AD0-ACC5-96C7C2B8FA10","index":1,"lines":[{"text":"EST. 2017","box":[[0.09726371268611911,0.9266723167739078],[0.05983303962869846,0.008421538048027633]]},{"text":"American Black Angus","box":[[0.1046511634431805,0.8939135169379553],[0.18459302482875528,0.013299392485843576]]},{"text":"Weight: 1,800lbs-2,200lbs","box":[[0.13081396104082985,0.7869598414309043],[0.13226743116446418,0.007583030127600717]]},{"text":"Source: Specialty farms across the Midwest","box":[[0.091569768903952,0.7784471521441194],[0.21220929571922786,0.00764549733114038]]},{"text":"\"America's Pride,\" \"The Steakhouse Classic\"","box":[[0.0828488368090917,0.7632565944755482],[0.22674418510274685,0.008671919613780745]]},{"text":"Black Angus is the dominant beef breed in the","box":[[0.08284884520874927,0.7470690113302282],[0.22383719640420682,0.0078047276524026606]]},{"text":"US. It is known for producing large muscles","box":[[0.08284884181903168,0.7386812562442823],[0.20930232054798315,0.007574456424727894]]},{"text":"with abundant marbling resulting in high","box":[[0.08139534802634674,0.7311067999604663],[0.1976744198630042,0.007579355683512364]]},{"text":"quality meat. We dry age our Prime grade","box":[[0.08139535478991138,0.7224985724905838],[0.20203487585622365,0.0078047276524026606]]},{"text":"Black Angus beef in house to maximize its","box":[[0.08139535611780645,0.7149829086005997],[0.20494185102746842,0.007602627989757406]]},{"text":"flavor by expelling water from the subprimals","box":[[0.0813953534681981,0.706489816806097],[0.21947674041098741,0.007625900020329546]]},{"text":"and, through enzmatic process, tenderizing the","box":[[0.0799418678967842,0.6987953253960786],[0.23110464109596635,0.0078047276524026606]]},{"text":"beef from within.","box":[[0.08139535317641423,0.6912796618504364],[0.08575580813360552,0.006688891415889286]]},{"text":"COTE","box":[[0.36587198566568824,0.9166064084208501],[0.2638955623545546,0.047489495690879555]]},{"text":"American Wagyu","box":[[0.42732558374899726,0.8939135165570349],[0.14098837020549365,0.013299393037189331]]},{"text":"Weight: 1,500lbs","box":[[0.45930232728698817,0.7869598415803363],[0.08284883296236079,0.007583030127600717]]},{"text":"Source: Nebraska & Georgia","box":[[0.43168604839493946,0.7793939592503227],[0.13808139503424893,0.0066986902091311805]]},{"text":"\"The Best of Both Worlds\"","box":[[0.4316860479496617,0.764123786558743],[0.136627900684979,0.006748908990036665]]},{"text":"American Wagyu is a hybrid of popular domestic","box":[[0.3808139571433099,0.7470690113302282],[0.235465110616481,0.0078047276524026606]]},{"text":"American breeds such as Black Angus and","box":[[0.38081395697574155,0.7386812562774204],[0.20348837020549365,0.007574456424727894]]},{"text":"Longhorn and the famed Wagyu of Japan. At","box":[[0.3808139611632907,0.7311068001730188],[0.21511627089047258,0.007579355407839511]]},{"text":"best we feel that this can offer the best of both","box":[[0.37936046545204377,0.7235323437382186],[0.2281976794520169,0.006770956205912687]]},{"text":"worlds - the bold, muscular meat of American","box":[[0.37936046640286736,0.7158501006522086],[0.22819767945201685,0.006735435752706469]]},{"text":"cattle tempered by the rich yet delicate marbling","box":[[0.37936046876115015,0.7064898167114163],[0.23691859143845584,0.0076259000203294965]]},{"text":"of Japanese beef. We source our all natural","box":[[0.3793604643271347,0.6987953254192696],[0.20639534537673837,0.0078047276524026606]]},{"text":"American Wagyu from a single producer.","box":[[0.3808139578099934,0.6903940970728023],[0.19622092551373416,0.007574456424727894]]},{"text":"The Cuts","box":[[0.44904038727451573,0.6607918146985426],[0.09465178361175758,0.014704633992533578]]},{"text":"COTE Galbi","box":[[0.4389534889946285,0.6146495335813467],[0.06686046275686708,0.007574456424727894]]},{"text":"FLATIRON, NYC","box":[[0.7994186072362417,0.9270958580182327],[0.10319767268836921,0.007575680963751108]]},{"text":"Japanese Wagyu","box":[[0.734011628193498,0.8939135169379553],[0.13517441986300416,0.013299392485843576]]},{"text":"Weight: 1,100lbs-1,200lbs","box":[[0.7398255842438093,0.7869598415803363],[0.12645348082197472,0.007583030127600717]]},{"text":"Source: Kagoshima & Miyazaki prefecture","box":[[0.7019088355477248,0.7778987876566765],[0.20371025842977752,0.010029361644938428]]},{"text":"\"The Sublime,\" \"The Butter Steak\"","box":[[0.7122093070075667,0.7632565946605111],[0.18168603613021528,0.007616100675741847]]},{"text":"Wagyu translates into \"Japanese cattle\"","box":[[0.6904069781080416,0.747069011172427],[0.19186045599321944,0.0078047276524026606]]},{"text":"and beef produced there is the rarest and","box":[[0.6904069794087474,0.7386812562774204],[0.200581395034249,0.007574456424727894]]},{"text":"most expensive on earth. Through dilligent","box":[[0.6889534911512615,0.7311068000783381],[0.21075580136995786,0.007579355683512364]]},{"text":"breeding and farming practices the Japanese","box":[[0.690406980552367,0.7224985724811158],[0.21656976523974258,0.0078047276524026606]]},{"text":"have developed beef with the most abundant","box":[[0.6904069803606143,0.7149829087031704],[0.2180232460617173,0.007602627714084503]]},{"text":"marbling of any breed. The resulting meat is","box":[[0.690406973497728,0.7064898170028693],[0.21366279006849787,0.007625899744656643]]},{"text":"astonishingly tender and toothsome, truly a","box":[[0.6889534851256349,0.6987953254000493],[0.21366279006849787,0.006747684175340548]]},{"text":"luxury experience.","box":[[0.6889534879469891,0.6912796618504364],[0.0915697652397427,0.006688891415889286]]},{"text":"• COTE Steak","box":[[0.6816273247077357,0.611634804234468],[0.09168720921726092,0.013603915106527939]]},{"text":"Skirt Steak","box":[[0.18603118516064124,0.4818935809965604],[0.05962367767983298,0.006759216828462284]]},{"text":"\"The Flatiron\"","box":[[0.45203488513791423,0.4819437179158326],[0.07558139503424899,0.0075987368777347105]]},{"text":"Hanger Steak","box":[[0.7078326299489024,0.4809399662602179],[0.06979985609122197,0.007717720387054795]]},{"text":"Tenderloin | Filet Mignon","box":[[0.17711210377922376,0.36092049305936036],[0.1312862423294825,0.010603097938202362]]},{"text":"NY Strip | Sirloin °","box":[[0.4517581614801801,0.3586070865165906],[0.10097438054727326,0.01157550478355981]]},{"text":"Ribsteak | Bone-in Ribeye °","box":[[0.709090480133219,0.3611435446382929],[0.14141292436748532,0.012998445324653631]]},{"text":"Only the Pinnacle of Beef","box":[[0.36918605051515163,0.23623269602651814],[0.25726743116446416,0.01612833682074943]]},{"text":"• = Aged 45 days inour dry aging room","box":[[0.7834302390574867,0.2484931894437064],[0.14244185102746854,0.006714020387126687]]},{"text":"At Cote we are proud to only serve the best of","box":[[0.09156977537823882,0.2172507395227775],[0.23255812191794104,0.007597248225155461]]},{"text":"the best - the very pinnacle of beef. Whether we","box":[[0.09156977700969647,0.2096683771508576],[0.23691859143845578,0.0075898052381399945]]},{"text":"are talking about domestic, hybrid, or imported, we","box":[[0.09011627725290701,0.2010509508193992],[0.25,0.007810612473527956]]},{"text":"only serve the highest grade of that beef available.","box":[[0.09156977865531218,0.1935296201448217],[0.24273254178094522,0.007600225530313961]]},{"text":"Domestically that means Prime grade, which","box":[[0.09156977298733564,0.1821553322246597],[0.21947674041098736,0.007613622575884799]]},{"text":"accounts for only 5% of American beef production.","box":[[0.09011628323643396,0.1744370120223617],[0.25,0.007810612473527956]]},{"text":"Our Black Angus beef has been certified by","box":[[0.09156977613188147,0.16602699556105022],[0.2107558013699579,0.00853853103084787]]},{"text":"the US Department of Agriculture to be of the","box":[[0.09156976598787081,0.15736937737196835],[0.22674418510274685,0.008678458303919945]]},{"text":"highest standard. Prime beef must be from young","box":[[0.09011629114925594,0.14894993289863317],[0.24273254178094528,0.008538531030847932]]},{"text":"cattle and exhibit abundant marbling. We further","box":[[0.09011627570185106,0.1423088532166312],[0.23982558013699584,0.0075898052381399945]]},{"text":"enhance it by dry aging select cuts in-house, just","box":[[0.09011628172747771,0.13471904778372532],[0.23691859143845578,0.006739822686937377]]},{"text":"like an old school steakhouse.","box":[[0.09011628045108269,0.12612692732764727],[0.14825581489725317,0.007643394523946663]]},{"text":"PRIME AS","box":[[0.48110465082646264,0.20302729705575592],[0.03197674379281118,0.005834266163742987]]},{"text":"CHOICE","box":[[0.4636627914272378,0.17456552652096302],[0.03197674379281118,0.005692354204485749]]},{"text":"A4","box":[[0.5247093024146806,0.1755142521939433],[0.010174418172092303,0.004743628411777934]]},{"text":"A3","box":[[0.5421511630397768,0.15179610994494674],[0.01162790660317059,0.005692354204485749]]},{"text":"SELECT","box":[[0.4448018197481731,0.13840769340240158],[0.03158240622662484,0.00947966679209542]]},{"text":"USDA ANGUS BEEF","box":[[0.40791647443091217,0.1097173356171599],[0.08361985497440849,0.01992323888805792]]},{"text":"A2","box":[[0.555232558525388,0.1385139504216776],[0.010174418172092303,0.005692354204485749]]},{"text":"AI","box":[[0.5639534885451907,0.12997541924068384],[0.008720929741014016,0.0056923542044858095]]},{"text":"BMS","box":[[0.5174418605585278,0.1128983569360243],[0.020348836344184607,0.00664107944543218]]},{"text":"- WAGYU RATING","box":[[0.5389417004137413,0.11526122048313281],[0.059238143001042354,0.01691595873327208]]},{"box":[[0.6598837239156056,0.21630945696444626],[0.21366279006849798,0.007594767229483598]],"text":"Our imported Japanese Wagyu is even more"},{"box":[[0.6598837244850971,0.20871965145371482],[0.22965116027399157,0.007663242213440415]],"text":"stringently graded, using the complex Japanese"},{"box":[[0.6598837242364173,0.20105095072649437],[0.22674418510274685,0.006719974721562842]],"text":"system that takes in to account such criteria as"},{"box":[[0.659883726011426,0.1925913145991253],[0.22093022123296213,0.007591790200205942]],"text":"muscle conformity, the color of the meat, and"},{"box":[[0.6598837263840293,0.18500150931248133],[0.22238371558223213,0.0066410794454321185]],"text":"the quality & luster of fat. In fact the Japanese"},{"box":[[0.6584302397734553,0.17646198544812908],[0.22529069075347685,0.00759079785711333]],"text":"use a separate grading system just to measure"},{"box":[[0.6584302339406245,0.1688731724077374],[0.24418604965751045,0.0075898052381399945]],"text":"intramuscular fat (the fat within the muscle) called"},{"box":[[0.6584302297133959,0.1593859156712173],[0.24418604965751045,0.009554739464420012]],"text":"the Beef Marbling Score (BMS). Things get pretty"},{"box":[[0.6598837252342269,0.15274086604645518],[0.25290696164394944,0.007593775162271829]],"text":"complicated, but we saved you the trouble - we only"},{"box":[[0.6584302368072534,0.1431945619955319],[0.24563953047948528,0.008678458303920005]],"text":"source A5, the highest grade, with marbling scores"},{"box":[[0.6584302360870669,0.13566777342562392],[0.14389534537673843,0.00853853103084787]],"text":"of 8-12 (the highest grade)."},{"box":[[0.6598837198978375,0.12523179087045613],[0.22238371558223213,0.0075898052381399945]],"text":"Whether domestic or Japanese, or something"},{"box":[[0.6584302469124202,0.1165806231115279],[0.23837207226043056,0.008678458303920005]],"text":"in-between like our American Wagyu, you can be"},{"box":[[0.6584302421939304,0.10905929259933049],[0.25726743116446427,0.007633966850746094]],"text":"assured that you are getting the finest beef on earth."},{"box":[[0.4331395394166408,0.07955253433577489],[0.12354650565072994,0.007810612473528018]],"text":"Our Promise Of Quality."},{"box":[[0.2747093077943312,0.07115442672943398],[0.4375,0.007589805238140056]],"text":"If any of our cuts do not meet your expectations, our team is committed to making it right."},{"box":[[0.7732558174824157,0.08064168367037436],[0.14389534537673843,0.006721463374142153]],"text":"Branding & Menu Design by Pentagram"},{"box":[[0.789244189847216,0.07492402327823644],[0.10901162303085876,0.006666385711637017]],"text":"Illustrations by Yondr Studio"},{"box":[[0.22819768234082488,0.04459010749879763],[0.23110464109596635,0.0075898052381399945]],"text":"COTEKOREANSTEAKHOUSE.COM"},{"box":[[0.4941860468437635,0.04743628443160297],[0.011627906603170646,0.004743628411777873]],"text":"77"},{"box":[[0.5377907005920037,0.04364138176652196],[0.18023255530824045,0.00853853103084787]],"text":"16 W 22ND ST, NY, NY 10010"}]}]